[
  {
    "id": "fusion_001_rover_live_command_wins",
    "category": "memory_task_fusion",
    "description": "A short direct rover command should stay device/task-like, not become episodic recall.",
    "setup": {
      "set_last_topic": "rover:session",
      "seed_temp_topic_memory": {
        "rover:session": [
          "User: go forward. Assistant: Moving forward.",
          "User: turn left. Assistant: Turning left.",
          "User: faster. Assistant: Increasing rover speed.",
          "User: stop. Assistant: Stopping rover."
        ]
      }
    },
    "turns": [
      {
        "turn": 1,
        "input": "go forward",
        "alive_checks": {
          "must_not_contain": [
            "brainstorm",
            "architecture",
            "from earlier",
            "let's discuss"
          ],
          "must_contain_one_of": [
            "forward",
            "moving",
            "rover"
          ],
          "expected_last_topic": "rover:session",
          "max_response_length": 800
        }
      }
    ]
  },
  {
    "id": "fusion_002_rover_reflection_memory_wins",
    "category": "memory_task_fusion",
    "description": "A rover brainstorming question should recall rover memory instead of treating it as live control.",
    "setup": {
      "set_last_topic": "test:episodic_memory",
