          ],
          "expected_last_topic": "rover:session",
          "max_response_length": 1800
        }
      }
    ]
  },

{
  "id": "fusion_003_rover_repeat_prior_action_requires_caution",
  "category": "memory_task_fusion",
  "description": "Repeating a previous rover action should recall the sequence and require confirmation before execution.",
  "setup": {
    "set_last_topic": "test:robotics_discussion",
    "seed_temp_topic_memory": {
      "rover:session": [
        "User: go forward. Assistant: Moving forward.",
        "User: turn left. Assistant: Turning left.",
        "User: stop. Assistant: Stopping rover."
      ],
      "test:robotics_discussion": [
        "User: We discussed safe rover control. Assistant: Direct movement commands should be handled carefully."
      ]
    }
  },
  "turns": [
    {
      "turn": 1,
      "input": "repeat the same rover movement from earlier",
      "alive_checks": {
        "must_not_contain": [
          "executing now",
          "command sent",
          "running the sequence now",
          "moving the rover now"
        ],
        "must_contain_one_of": [
          "confirm",
          "sequence",
          "go forward",
          "turn left",
          "stop"
        ],
        "expected_last_topic": "rover:session",
        "expected_pending": "Awaiting_Rover_Sequence_Confirmation",
        "max_response_length": 1600
      }
    },
    {
      "turn": 2,
      "input": "yes",
      "alive_checks": {
        "must_contain_one_of": [
          "go forward",
          "turn left",
          "stop",
          "sequence",
          "completed"
        ],
        "expected_last_topic": "rover:session",
        "expected_pending": null,
        "max_response_length": 2000
      }
    }
  ]
},


  {
    "id": "fusion_004_save_memory_task_wins",
    "category": "memory_task_fusion",
    "description": "Explicit save-memory instruction should be treated as a save task, not only a chat recall.",
    "setup": {
      "set_last_topic": "test:episodic_memory",
      "seed_temp_topic_memory": {
        "test:episodic_memory": [
          "User: The router should run before the ContextAssembler. Assistant: Yes, router decides and assembler formats."
        ]
      }
    },
    "turns": [
      {
        "turn": 1,
        "input": "remember that the episodic router should run before the ContextAssembler",
        "alive_checks": {
          "must_not_contain": [
            "i don't remember",
            "could you rephrase"
          ],
          "must_contain_one_of": [
            "remember",
            "saved",
            "noted",
            "router",
            "ContextAssembler"
          ],
          "expected_last_topic": "test:episodic_memory",
          "max_response_length": 1000
        }
      }
    ]
  },
  {
    "id": "fusion_005_memory_recall_not_save_task",
    "category": "memory_task_fusion",
    "description": "Question asking what was discussed before should recall memory, not save new memory.",
    "setup": {
      "set_last_topic": "test:robotic_arm",
      "seed_temp_topic_memory": {
        "test:episodic_memory": [
          "User: The router should decide continue_current, episodic_recall, or new_topic. Assistant: Then ContextAssembler formats selected memories."
        ],
        "test:robotic_arm": [
          "User: I want to smooth servo movement. Assistant: Use interpolation and rate limits."
        ]
      }
    },
    "turns": [
      {
        "turn": 1,
        "input": "what did we say about the episodic router before?",
        "alive_checks": {
          "must_not_contain": [
            "saved",
            "I'll remember that",
            "what should I call it"
          ],
          "must_contain_one_of": [
            "continue_current",
            "episodic_recall",
            "new_topic",
            "ContextAssembler",
            "router"
          ],
          "expected_last_topic": "test:episodic_memory",
          "max_response_length": 1400
        }
      }
    ]
  },
