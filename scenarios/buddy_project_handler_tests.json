[
  {
    "id": "project_open_happy_path",
    "category": "project_handler",
    "description": "THz trigger detected — note found with high confidence — user confirms resume",
    "setup": {
      "mock_note_result": {
        "path": "Daily_Note_01_04_26.txt",
        "confidence": 1.0,
        "file_date": "2026-04-01",
        "spoken_name": "Daily Note from April 1st, 2026",
        "ask_user": false,
        "open_explorer": false
      },
      "mock_matlab_state": "not_running",
      "mock_matlab_open": true
    },
    "turns": [
      {
        "turn": 1,
        "input": "Open my terahertz project",
        "alive_checks": {
          "must_contain_one_of": [
            "terahertz", "thz", "matlab", "opening", "april"
          ],
          "must_not_contain": [
            "something went wrong",
            "i don't understand",
            "couldn't find"
          ],
          "note": "Should open project, read note, speak summary, ask if ready to continue"
        }
      },
      {
        "turn": 2,
        "input": "Yes let's continue",
        "alive_checks": {
          "must_contain_one_of": [
            "opened", "active", "working on", "what would you like",
            "terahertz", "discuss"
          ],
          "must_not_contain": [
            "something went wrong",
            "i don't understand"
          ],
          "note": "Should confirm topic opened and hand off to conversation"
        }
      }
    ]
  },

