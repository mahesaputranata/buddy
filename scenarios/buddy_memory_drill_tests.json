[
  {
    "id": "save_happy_path",
    "category": "memory_save",
    "description": "Basic save flow: topic name → add note → save trigger",
    "turns": [
      {
        "turn": 1,
        "input": "Can you take a note?",
        "alive_checks": {
          "must_contain_one_of": ["what should i call", "what topic", "call this topic"],
          "must_not_contain": ["something went wrong", "let's start over"],
          "note": "Should enter Awaiting_Topic"
        }
      },
      {
        "turn": 2,
        "input": "Job application strategy",
        "alive_checks": {
          "must_contain_one_of": ["job application", "got it", "save this under"],
          "must_not_contain": ["something went wrong", "what should i call"],
          "note": "Should confirm topic and enter Awaiting_Topic_Content"
        }
      },
      {
        "turn": 3,
        "input": "Focus on computer vision and control systems projects",
        "alive_checks": {
          "must_contain_one_of": ["added that", "current notes", "keep adding"],
          "must_not_contain": ["something went wrong"],
          "note": "Should append note and stay in Awaiting_Topic_Content"
        }
      },
      {
        "turn": 4,
        "input": "Save it",
        "alive_checks": {
          "must_contain_one_of": ["saved", "long-term memory", "stored"],
          "must_not_contain": ["added that", "current notes", "something went wrong"],
          "note": "Should trigger save and exit FSM"
        }
      }
    ]
  },

