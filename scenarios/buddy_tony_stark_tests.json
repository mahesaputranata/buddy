  {
    "id": "self_correction_cancel",
    "category": "conversational_repair",
    "description": "Tony corrects himself mid-sentence — nothing should get saved or triggered",
    "turns": [
      {
        "turn": 1,
        "input": "remind me about the — actually no forget it, I'll handle it myself",
        "alive_checks": {
          "must_not_contain": ["saved", "scheduled", "reminder set", "Let's start over"],
          "must_contain_one_of": ["alright", "okay", "sure", "got it", "no problem",
                                  "noted", "nothing", "understood"],
          "must_feel": "graceful_cancel"
        }
      }
    ]
  },

  {
    "id": "ambient_desk_awareness",
    "category": "vision_awareness",
    "description": "Tony mentions new hardware casually — Buddy notices without being asked",
    "turns": [
